# نموذج متغيرات البيئة — انسخه إلى .env.local محليًا أو إلى Netlify/Vercel → Environment Variables
# لا تضع قيمًا حقيقية في هذا الملف ولا ترفع أي سر إلى Git إطلاقًا.

# إلزاميان — قاعدة Turso (libSQL عبر HTTP)
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# خدمة دمج الفيديو (مشروع merger/ المنفصل بعد نشره على Vercel)
MERGER_API_BASE=https://<merger-domain>.vercel.app

# اختياري:
# MCP_ACCESS_TOKEN=            # إن ضُبط يُطلب Authorization: Bearer <token> على /mcp
# KIE_IMAGE_MODEL=             # تجاوز أسماء الموديلات إن لزم
# KIE_VIDEO_MODEL=
# COMETAPI_IMAGE_MODEL=
# COMETAPI_VIDEO_MODEL=
