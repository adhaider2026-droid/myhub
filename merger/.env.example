# انسخه إلى .env محليًا أو ضع القيم في Vercel → Settings → Environment Variables
# لا تضع قيمًا حقيقية هنا ولا ترفع أي سر إلى Git.
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>
MERGER_PORT=3001
# اختياري (القيم الافتراضية بالأقواس):
# MAX_SOURCES=10
# SOURCE_MAX_MB=200
# OUTPUT_MAX_MB=150
# MAX_TOTAL_DURATION_SEC=600
# UPLOAD_CHUNK_BYTES=4194304
# FFMPEG_PRESET=medium
# FFMPEG_PATH=            # مسار ffmpeg يدوي (افتراضي: ffmpeg-static ثم PATH)
# FFPROBE_PATH=           # مسار ffprobe يدوي (افتراضي: ffprobe-static ثم PATH)
